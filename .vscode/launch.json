{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SmartPodbor: offline demo",
      "type": "debugpy",
      "request": "launch",
      "module": "smartphone_bot",
      "args": ["--demo", "--example"],
      "console": "integratedTerminal",
